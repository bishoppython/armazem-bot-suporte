# Copie para .env e ajuste. O .env nunca vai para o Git.

# true = sem LLM (resposta extrativa); false = usa o LLM abaixo
BOT_MODO_DEMO=false

# Qualquer servidor compatível com a API da OpenAI:
#   Ollama local:  http://localhost:11434/v1   (chave: ollama)
#   Groq:          https://api.groq.com/openai/v1
#   OpenRouter:    https://openrouter.ai/api/v1
BOT_LLM_BASE_URL=http://localhost:11434/v1
BOT_LLM_API_KEY=ollama
BOT_LLM_MODELO=qwen3.5:4b

# Modelo de embeddings (vazio = busca só com BM25)
BOT_EMBED_MODELO=nomic-embed-text

# Pasta da empresa atendida (docs/*.md + catalogo.json + catalogo/*.jpg)
BOT_EMPRESA_DIR=empresas/armazem-agreste
BOT_BANCO_URL=sqlite:///dados/bot.db
BOT_LIMIAR_CONFIANCA=0.35
